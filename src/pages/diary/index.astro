---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('diary', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<Base title="Diary | Murat Can Yuksel" description="Notes on building software with AI agents.">
  <main id="main">
    <section>
      <h1 class="section-title">Diary</h1>
      {posts.length === 0 ? (
        <p>First posts are on the way.</p>
      ) : (
        <div class="diary-index">
          {posts.map((post) => (
            <article class="diary-card">
              <h2><a href={`/diary/${post.id}/`}>{post.data.title}</a></h2>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</Base>
