        </article>

        <article class="project-card" id="claude-code-mods" data-reveal="card">
          <a href="#claude-code-mods" class="project-link">
            <div class="project-art">
              <svg class="motif" viewBox="0 0 320 180" aria-hidden="true" focusable="false">
                <defs>
                  <symbol id="plug" viewBox="0 0 40 60">
                    <path d="M12 2 V18 M28 2 V18 M6 18 H34 V38 Q34 48 24 48 H16 Q6 48 6 38 Z M20 48 V58"/>
                  </symbol>
                </defs>
                <use href="#plug" x="8" y="60" width="40" height="60"/>
                <use href="#plug" x="56" y="60" width="40" height="60"/>
                <use href="#plug" x="104" y="60" width="40" height="60"/>
                <use href="#plug" x="152" y="60" width="40" height="60"/>
