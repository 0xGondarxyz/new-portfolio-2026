            <div class="project-art">
              <svg class="motif" viewBox="0 0 320 180" aria-hidden="true" focusable="false">
                <path d="M32 40 Q96 28 152 44 V148 Q96 134 32 146 Z"/>
                <path d="M168 44 Q224 28 288 40 V146 Q224 134 168 148 Z"/>
                <path class="a" d="M52 68 H118 V96 H72 L56 110 V96 H52 Z"/>
                <path class="a" d="M190 84 H262 V112 H248 L238 124 V112 H190 Z"/>
                <path d="M52 124 H124 M190 132 H258"/>
              </svg>
            </div>
            <div class="project-content">
              <span class="project-mark" aria-hidden="true"></span>
              <h3 class="project-title">TaleTongue</h3>
              <p class="project-summary">Story based language learning app for Turkish and Chinese.</p>
