---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const diaryOrder = [
  'how-i-pick-models',
  'my-claude-code-setup',
  'how-the-ai-influencer-was-made',
  'building-a-youtube-video-pipeline-for-zero-dollars',
  'shipping-an-ios-app-from-linux',
  'copying-a-hit-game-and-making-it-better',
];
const diaryPosts = (await getCollection('diary')).sort(
  (a, b) => diaryOrder.indexOf(a.id) - diaryOrder.indexOf(b.id),
);
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Murat Can Yuksel',
  alternateName: '0xGondar',
  jobTitle: 'Software developer',
  sameAs: ['https://github.com/0xGondarxyz'],
};
---

<Base
  title="Murat Can Yuksel | AI Automation Developer"
  description="Solo developer building apps, games and automations with AI agents. Open to AI automation roles."
  jsonLd={personJsonLd}
>
<main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <canvas class="hero-grid" aria-hidden="true"></canvas>
      <p class="hero-name">Murat Can Yuksel</p>
      <h1 id="hero-title"><span class="hero-word">One</span> <span class="hero-word">developer.</span><br><span class="hero-word">Many</span> <span class="hero-word">moving</span> <span class="hero-word">parts.</span></h1>

      <div class="hero-body">
        <div>
          <p class="hero-intro">Solo developer building apps, games and automations with AI agents.</p>
          <p class="hero-availability">Open to AI automation roles, full time and freelance.</p>
          <a href="#projects" class="cta">View projects</a>
          <p class="hero-count">10 projects. 6 diary posts on the way.</p>
        </div>

        <div class="agent-console" role="group" aria-label="AI agent shipping console">
          <div class="console-titlebar">
            <span>~/indie</span>
            <span class="console-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          </div>
          <div class="console-command"><span>$ ship </span><span id="ship-slug"></span><span class="command-cursor" aria-hidden="true">█</span></div>
          <div class="console-flow">
            <svg id="hero-diagram" class="hero-diagram" viewBox="-16 0 432 140" role="img" aria-label="Project workflow: Plan with GPT-6.1 Sol, Code with GPT-6 Luna, Review with Claude Opus 5.5">
              <path class="route" d="M50 70 H350"/>
              <rect class="stage" x="-16" y="20" width="132" height="100"/>
              <rect class="stage" x="134" y="20" width="132" height="100"/>
              <rect class="stage" x="284" y="20" width="132" height="100"/>
              <text class="stage-label" x="50" y="52">Plan</text>
              <text class="stage-chip" x="50" y="94">GPT-6.1 Sol</text>
              <text class="stage-label" x="200" y="52">Code</text>
              <text class="stage-chip" x="200" y="94">GPT-6 Luna</text>
              <text class="stage-label" x="350" y="52">Review</text>
              <text class="stage-chip" x="350" y="94">Claude Opus 5.5</text>
              <rect class="signal" x="40" y="60" width="20" height="20"/>
            </svg>
            <div class="shipped-stamp" id="shipped-stamp" aria-hidden="true">SHIPPED</div>
          </div>
          <div class="shelf" aria-label="Shipped project shelf">
            <div class="shelf-slot" aria-label="Empty cartridge slot 1"><span class="shelf-tile"></span></div>
            <div class="shelf-slot" aria-label="Empty cartridge slot 2"><span class="shelf-tile"></span></div>
            <div class="shelf-slot" aria-label="Empty cartridge slot 3"><span class="shelf-tile"></span></div>
            <div class="shelf-slot" aria-label="Empty cartridge slot 4"><span class="shelf-tile"></span></div>
            <div class="shelf-slot" aria-label="Empty cartridge slot 5"><span class="shelf-tile"></span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="setup" class="setup">
      <h2 class="section-title">How I work</h2>

      <svg id="setup-strip" class="setup-strip" viewBox="0 0 600 80" role="img" aria-label="Plan, Code and Review stages in order">
        <path class="route" d="M160 40 H220 M380 40 H440"/>
        <rect class="stage" x="0" y="0" width="160" height="80"/>
        <rect class="stage" x="220" y="0" width="160" height="80"/>
        <rect class="stage" x="440" y="0" width="160" height="80"/>
        <text class="stage-label" x="80" y="70">Plan</text>
        <text class="stage-label" x="300" y="70">Code</text>
        <text class="stage-label" x="520" y="70">Review</text>
        <rect class="signal" x="72" y="32" width="16" height="16"/>
      </svg>
      <button class="replay-btn" id="replay" type="button">Replay workflow</button>

      <div class="setup-row">
        <div class="setup-verb">Plan</div>
        <p class="setup-desc">Plan with one model.</p>
      </div>
      <div class="setup-row">
        <div class="setup-verb">Code</div>
        <p class="setup-desc">Code with another.</p>
      </div>
      <div class="setup-row">
        <div class="setup-verb">Review</div>
        <p class="setup-desc">Review with a third.</p>
      </div>

      <p class="setup-note">I write no code by hand. Notes on model choice, cost per task, Claude Code mods, memory, skills and hooks are in the planned diary.</p>
    </section>

    <section id="projects">
      <h2 class="section-title">Projects</h2>

      <div class="projects-grid">
        <article class="project-card" id="kestrel" data-reveal="card">
          <a href="#kestrel" class="project-link">
            <div class="project-art">
              <svg class="motif" viewBox="0 0 320 180" aria-hidden="true" focusable="false">
                <path d="M160 50 C128 34 90 34 56 44 V140 C90 130 128 130 160 146 C192 130 230 130 264 140 V44 C230 34 192 34 160 50 Z"/>
                <path d="M160 50 V146"/>
                <path d="M76 72 H136 M76 92 H136 M76 112 H116"/>
                <rect class="af" x="186" y="78" width="60" height="18"/>
                <path d="M186 70 H246 M186 104 H246"/>
              </svg>
            </div>
            <div class="project-content">
              <span class="project-mark" aria-hidden="true"></span>
              <h3 class="project-title">Kestrel Reader</h3>
              <p class="project-summary">Speed reading app against doomscrolling. React Native.</p>
              <p class="project-hard">Hard part: shipping to stores from Linux, no Mac.</p>
            </div>
          </a>
        </article>

        <article class="project-card" id="crash-dummy-yard" data-reveal="card">
          <a href="#crash-dummy-yard" class="project-link">
            <div class="project-art">
              <svg class="motif" viewBox="0 0 320 180" aria-hidden="true" focusable="false">
                <rect class="solid" x="36" y="136" width="248" height="12"/>
                <circle class="af" cx="150" cy="58" r="14"/>
                <path d="M150 74 V106 M150 84 L120 102 M150 84 L186 66 M150 106 L128 134 M150 106 L174 130"/>
