    <section class="about-section" id="about">
      <div class="about-bio">
        <h2>About</h2>
        <p>5 to 8 years working with React, Next.js, Node, TypeScript, React Native and Solidity. BA Comparative Literature; MA Semiotics. Turkish, English and French. Lived in Bangkok, Chiang Mai and Da Nang. Trains Muay Thai.</p>
        <p class="secondary">Former web3 security auditor (Code4rena, Sherlock, Cantina): 15 High + 15 Medium findings. Fuzzing and invariant testing at Recon, Jan to Jun 2026.</p>
      </div>

      <div class="contact-area" id="contact">
        <span class="contact-baseline" data-reveal="rule"></span>
        <h2 class="contact-heading">Hire me</h2>
        <p class="contact-text">Open to AI automation roles, full time and freelance.</p>
        <a href="https://github.com/0xGondarxyz" class="contact-link" target="_blank" rel="noopener noreferrer">github.com/0xGondarxyz</a>
      </div>
    </section>
  </main>

<script>
    const root = document.documentElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Signal path: [x, y, offset, stage lit when reached]
    const HERO_PATH = [[0, 0, 0, 0], [150, 0, 0.5, 1], [300, 0, 1, 2]];
    const STRIP_PATH = [[0, 0, 0, 0], [220, 0, 0.5, 1], [440, 0, 1, 2]];

    function playSignal(square, stages, path, duration, delay = 0) {
      (square.timers || []).forEach(clearTimeout);
      square.timers = [];
      square.getAnimations().forEach(a => a.cancel());
      stages.forEach(s => s.classList.remove('on'));
      square.animate(
        path.map(([x, y, offset]) => ({ transform: `translate(${x}px, ${y}px)`, offset, easing: 'steps(4, end)' })),
        { duration, delay, fill: 'both' }
      );
      path.forEach(([, , offset, stage]) => {
        if (stage !== undefined) {
          square.timers.push(setTimeout(() => stages[stage].classList.add('on'), delay + offset * duration));
        }
      });
    }

    const heroDiagram = document.getElementById('hero-diagram');
    const stripDiagram = document.getElementById('setup-strip');
    const heroStages = heroDiagram.querySelectorAll('.stage');
    const stripStages = stripDiagram.querySelectorAll('.stage');
    const heroSignal = heroDiagram.querySelector('.signal');
    const stripSignal = stripDiagram.querySelector('.signal');
    const heroSection = heroDiagram.closest('.hero');
    const shipSlug = document.getElementById('ship-slug');
    const shippedStamp = document.getElementById('shipped-stamp');
    const shelfSlots = [...document.querySelectorAll('.shelf-slot')];
    const shipSlugs = ['kestrel-reader', 'crash-dummy-yard', 'yoyo', 'doodle-channels', 'hushpane'];
    const shipCodes = ['KR', 'CD', 'YO', 'DC', 'HP'];
    const gridCanvas = heroSection.querySelector('.hero-grid');
    const gridContext = gridCanvas.getContext('2d');
    const hoverPointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const cellSize = 16;
    const trail = new Map();
    let blinkCells = [], gridWidth = 0, gridHeight = 0, pixelRatio = 1, gridVisible = false, gridFrame = 0;

    function drawGrid(now) {
      const colors = getComputedStyle(root);
      gridContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      gridContext.clearRect(0, 0, gridWidth, gridHeight);
      gridContext.strokeStyle = colors.getPropertyValue('--line').trim();
      gridContext.globalAlpha = 0.12;
      gridContext.beginPath();
      for (let x = 0.5; x < gridWidth; x += cellSize) { gridContext.moveTo(x, 0); gridContext.lineTo(x, gridHeight); }
      for (let y = 0.5; y < gridHeight; y += cellSize) { gridContext.moveTo(0, y); gridContext.lineTo(gridWidth, y); }
      gridContext.stroke();
      if (!reduced) {
        gridContext.fillStyle = colors.getPropertyValue('--accent').trim();
        if (hoverPointer) {
          for (const [key, cell] of trail) {
            const fade = 1 - (now - cell.time) / 600;
            if (fade <= 0) { trail.delete(key); continue; }
            gridContext.globalAlpha = fade * cell.power * 0.55;
            gridContext.fillRect(cell.x * cellSize + 1, cell.y * cellSize + 1, 14, 14);
          }
        } else blinkCells.forEach(cell => {
          gridContext.globalAlpha = 0.08 + Math.max(0, Math.sin(now / 1100 + cell.phase)) * 0.34;
          gridContext.fillRect(cell.x * cellSize + 1, cell.y * cellSize + 1, 14, 14);
        });
      }
      gridContext.globalAlpha = 1;
    }

    const drawGridFrame = now => {
      gridFrame = 0;
      drawGrid(now);
      if (gridVisible && !reduced) gridFrame = requestAnimationFrame(drawGridFrame);
    };
    const resizeHeroGrid = () => {
      const bounds = heroSection.getBoundingClientRect();
      gridWidth = bounds.width; gridHeight = bounds.height; pixelRatio = window.devicePixelRatio || 1;
      gridCanvas.width = Math.round(gridWidth * pixelRatio); gridCanvas.height = Math.round(gridHeight * pixelRatio);
      trail.clear();
      const columns = Math.ceil(gridWidth / cellSize), rows = Math.ceil(gridHeight / cellSize);
      blinkCells = Array.from({ length: 3 + Math.floor(Math.random() * 3) }, () => ({
        x: Math.floor(Math.random() * columns), y: Math.floor(Math.random() * rows), phase: Math.random() * Math.PI * 2
      }));
      if (gridVisible) drawGrid(performance.now());
    };
    new ResizeObserver(resizeHeroGrid).observe(heroSection);
    new IntersectionObserver(entries => {
      gridVisible = entries[0].isIntersecting;
      if (gridVisible) {
        drawGrid(performance.now());
        if (!reduced && !gridFrame) gridFrame = requestAnimationFrame(drawGridFrame);
      } else { cancelAnimationFrame(gridFrame); gridFrame = 0; }
    }).observe(heroSection);
    new MutationObserver(() => { if (gridVisible) drawGrid(performance.now()); }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    heroSection.addEventListener('pointermove', event => {
      if (!hoverPointer || event.pointerType === 'touch') return;
      const bounds = heroSection.getBoundingClientRect();
      const centerX = Math.floor((event.clientX - bounds.left) / cellSize), centerY = Math.floor((event.clientY - bounds.top) / cellSize);
      for (let y = -2; y <= 2; y++) for (let x = -2; x <= 2; x++) {
        const distance = Math.hypot(x, y);
        if (distance <= 2.4) trail.set((centerX + x) + ',' + (centerY + y), {
          x: centerX + x, y: centerY + y, time: performance.now(), power: 1 - distance / 2.6
        });
      }
    });

    function shipProject(index) {
      const slug = shipSlugs[index];
      let position = 0;
      shipSlug.textContent = '';
      const typeNext = () => {
        shipSlug.textContent = slug.slice(0, ++position);
        if (position < slug.length) return setTimeout(typeNext, 45);
        playSignal(heroSignal, heroStages, HERO_PATH, 900);
        setTimeout(() => {
          shippedStamp.className = 'shipped-stamp show';
          setTimeout(() => {
            shippedStamp.className = 'shipped-stamp fade';
            setTimeout(() => {
              shippedStamp.className = 'shipped-stamp';
              const slot = shelfSlots[index], tile = slot.querySelector('.shelf-tile');
              tile.textContent = shipCodes[index];
              slot.classList.add('filled');
              slot.setAttribute('aria-label', shipCodes[index] + ' cartridge');
              tile.classList.remove('drop');
              void tile.offsetWidth;
              tile.classList.add('drop');
              heroStages.forEach(stage => stage.classList.remove('on'));
              heroSignal.setAttribute('transform', 'translate(0 0)');
              if (index < 4) shipProject(index + 1);
              else setTimeout(() => {
                shelfSlots.forEach((emptySlot, slotIndex) => {
                  emptySlot.classList.remove('filled');
                  emptySlot.setAttribute('aria-label', 'Empty cartridge slot ' + (slotIndex + 1));
                  emptySlot.querySelector('.shelf-tile').textContent = '';
                });
                shipProject(0);
              }, 2000);
            }, 180);
          }, 880);
        }, 900);
      };
      typeNext();
    }

    if (reduced) {
      heroSignal.setAttribute('transform', 'translate(300 0)');
      stripSignal.setAttribute('transform', 'translate(440 0)');
      [...heroStages, ...stripStages].forEach(s => s.classList.add('on'));
      shipSlug.textContent = 'hushpane';
      shelfSlots.forEach((slot, index) => {
        slot.classList.add('filled');
        slot.setAttribute('aria-label', shipCodes[index] + ' cartridge');
        slot.querySelector('.shelf-tile').textContent = shipCodes[index];
      });
    } else {
      shipProject(0);
      document.getElementById('replay').addEventListener('click', () => {
        playSignal(stripSignal, stripStages, STRIP_PATH, 1200);
      });

      // Cards and the contact rule rise in once, staggered by position
      const items = [...document.querySelectorAll('[data-reveal]')];
      const io = new IntersectionObserver(entries => {
        entries.forEach(({ target, isIntersecting }) => {
          if (!isIntersecting) return;
          io.unobserve(target);
          const rule = target.dataset.reveal === 'rule';
          target.animate(
            [
              { transform: rule ? 'scaleX(0)' : 'translateY(16px)' },
              { transform: 'none' }
            ],
            {
              duration: rule ? 460 : 400,
              delay: rule ? 0 : (items.indexOf(target) % 3) * 80,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'both'
            }
          );
        });
      }, { threshold: 0.2 });
      items.forEach(el => io.observe(el));
    }

    document.getElementById('back-top').addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
</script>
</Base>
