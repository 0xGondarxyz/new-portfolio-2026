    </section>

    <section id="diary">
      <h2 class="section-title">Planned diary</h2>

      <div class="diary-grid">
        {diaryPosts[0] && (
          <article class="diary-card lead">
            <h3>{diaryPosts[0].data.draft ? diaryPosts[0].data.title : <a href={`/diary/${diaryPosts[0].id}/`}>{diaryPosts[0].data.title}</a>}</h3>
            <p>{diaryPosts[0].data.description}</p>
            {diaryPosts[0].data.draft && <span class="diary-tag">Coming soon</span>}
          </article>
        )}

        <div class="diary-index">
          {diaryPosts.slice(1).map((post) => (
            <article class="diary-card">
              <h3>{post.data.draft ? post.data.title : <a href={`/diary/${post.id}/`}>{post.data.title}</a>}</h3>
              <p>{post.data.description}</p>
              {post.data.draft && <span class="diary-tag">Coming soon</span>}
