                <rect x="124" y="112" width="72" height="40"/>
                <path d="M100 62 H124 M196 62 H220 M160 84 V112"/>
              </svg>
            </div>
            <div class="project-content">
              <span class="project-mark" aria-hidden="true"></span>
              <h3 class="project-title">Hermes agent</h3>
