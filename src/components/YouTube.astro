---
interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props;
---

<div
  class="youtube-preview"
  data-youtube-preview
  data-video-id={videoId}
  data-video-title={title}
>
  <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt="" loading="lazy" />
  <button type="button" aria-label={`Play video: ${title}`}>
    <span class="youtube-play" aria-hidden="true">▶</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-youtube-preview]').forEach((preview) => {
    const button = preview.querySelector('button');
    button?.addEventListener('click', () => {
      const videoId = preview.dataset.videoId;
      if (!videoId) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.title = preview.dataset.videoTitle ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'youtube-frame';
      preview.replaceWith(iframe);
    });
  });
</script>
